# Copy to .management-credentials.plaintext.yaml, fill locally, then SOPS-encrypt.
apiVersion: v1
kind: Secret
metadata:
  name: logto-management
  namespace: prod
type: Opaque
stringData:
  credentials: |
    {
      "hostname": "logto.isning.moe",
      "resource": "https://default.logto.app/api",
      "application_id": "REPLACE_WITH_MANAGEMENT_APP_ID",
      "application_secret": "REPLACE_WITH_MANAGEMENT_APP_SECRET"
    }
